{
  "name": "yondako",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem -H local.yondako.com",
    "dev:cert": "mkdir -p certificates && mkcert -cert-file certificates/localhost.pem -key-file certificates/localhost-key.pem local.yondako.com localhost 127.0.0.1 ::1",
    "dev:wrangler": "wrangler dev --ip 0.0.0.0 --port 3000 --local-protocol https --local-upstream local.yondako.com --https-key-path ./certificates/localhost-key.pem --https-cert-path ./certificates/localhost.pem",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "start": "next start",
    "check": "biome check",
    "fmt": "biome format --write",
    "test": "bun test",
    "test:storybook": "test-storybook",
    "vrt:storybook": "playwright test -c .storybook/playwright.config.ts .storybook/",
    "vrt:storybook:update": "UPDATE=1 playwright test -c .storybook/playwright.config.ts .storybook/ --update-snapshots",
    "generate:schema": "drizzle-kit generate --dialect sqlite --out ./src/db/migrations --schema",
    "generate:svg": "bunx svgo ./src/assets/**/*.svg",
    "preview": "opennextjs-cloudflare build && bun run dev:wrangler",
    "preview:storybook": "bunx http-server storybook-static --port 6006 --silent",
    "prepreview:storybook": "storybook build --test",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "drizzle:studio": "bun --env-file=.env.local  run drizzle-kit studio",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "db:migrate": "wrangler d1 migrations apply yondako_dev --local",
    "db:migrate:dev": "wrangler d1 migrations apply yondako_dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply yondako --remote --env production",
    "db:push": "wrangler d1 execute yondako_dev --local --file=$(ls ./src/db/migrations/*.sql | fzf)",
    "db:push:dev": "wrangler d1 execute yondako_dev --remote --file=$(ls ./src/db/migrations/*.sql | fzf)",
    "db:push:prod": "wrangler d1 execute yondako --remote --file=$(ls ./src/db/migrations/*.sql | fzf) --env production",
    "db:backfill-thumbnails": "bun run scripts/backfill-thumbnails.ts",
    "db:backfill-thumbnails:dev": "bun run scripts/backfill-thumbnails.ts --remote",
    "db:backfill-thumbnails:prod": "bun run scripts/backfill-thumbnails.ts --remote --env production"
  },
  "dependencies": {
    "@ericblade/quagga2": "^1.12.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@react-spring/web": "^10.1.2",
    "better-auth": "^1.7.7",
    "budoux": "^0.8.4",
    "cloudflare": "^6.5.0",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "kysely": "^0.29.6",
    "kysely-d1": "^0.4.0",
    "ndarray-pixels": "^5.2.0",
    "next": "^16.3.8",
    "p-limit": "^7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-swipeable": "^7.0.2",
    "react-use": "^17.6.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tiny-segmenter": "^0.2.0",
    "use-debounce": "^10.1.1",
    "uuid": "^14.0.2",
    "valibot": "^1.5.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@happy-dom/global-registrator": "^20.14.5",
    "@libsql/client": "^0.17.4",
    "@opennextjs/cloudflare": "^1.20.8",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/test-runner": "^0.26.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/bun": "^1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tiny-segmenter": "^0.2.0",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.1.16",
    "postcss": "^8.5.28",
    "storybook": "^10.6.1",
    "storybook-addon-pseudo-states": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vercel": "62.2.0",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "string-width": "7.2.0",
    "fast-xml-parser@5": "5.11.2",
    "tar": "7.5.22",
    "ajv@8": "8.20.0",
    "esbuild": "0.28.2",
    "js-yaml@4": "4.3.2",
    "minimatch@10": "10.2.6",
    "path-to-regexp@6": "6.3.0",
    "path-to-regexp@8": "8.4.2",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "undici@5": "6.29.0",
    "uuid@8": "11.1.1",
    "uuid@9": "11.1.1",
    "webpack-dev-middleware": "7.4.6"
  },
  "imports": {
    "#actions/updateReadingStatus": {
      "storybook": "./src/actions/updateReadingStatus.mock.ts",
      "default": "./src/actions/updateReadingStatus.ts"
    },
    "#actions/signInWithRedirect": {
      "storybook": "./src/actions/signInWithRedirect.mock.ts",
      "default": "./src/actions/signInWithRedirect.ts"
    },
    "#actions/signOutWithRedirect": {
      "storybook": "./src/actions/signOutWithRedirect.mock.ts",
      "default": "./src/actions/signOutWithRedirect.ts"
    },
    "#actions/goodbyeUser": {
      "storybook": "./src/actions/goodbyeUser.mock.ts",
      "default": "./src/actions/goodbyeUser.ts"
    },
    "#actions/searchFromIsbn": {
      "storybook": "./src/actions/searchFromIsbn.mock.ts",
      "default": "./src/actions/searchFromIsbn.ts"
    },
    "#hooks/useUpdateReadingStatus": {
      "storybook": "./src/hooks/useUpdateReadingStatus.mock.ts",
      "default": "./src/hooks/useUpdateReadingStatus.ts"
    },
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  }
}
